---
import PortalShell from '../../../components/PortalShell.astro';
import { documents } from '../../../lib/data.js';
const qs = [
  { name: 'orgtype', pass: 'yes', q: 'Is your organization a 501(c)(3) nonprofit organization, a public school district, or a college or university?' },
  { name: 'geo', pass: 'yes', q: 'Does the proposed work serve public school students in Brannock County, North Carolina, or is it a state-level initiative in North Carolina?' },
  { name: 'focus', pass: 'yes', q: 'Does the proposed work fall within Early Grades Achievement (kindergarten through third grade) Educators & Leaders (recruiting, developing and retaining K-12 teachers and school leaders), or Extracurricular Activities (high-quality extracurricular activities that strengthen student engagement and growth in learning)?' },
  { name: 'excluded', pass: 'no', q: 'Is the request for an individual, a private elementary or secondary school, an international program, or primarily for fundraising (such as event sponsorship, door prizes or giveaways)?' },
  { name: 'reviewed', pass: 'yes', q: 'Have you reviewed the Foundation’s Mission & Guidelines and Outcomes Sought document?' },
];
---
<PortalShell title="Eligibility Quiz">
  <div class="portal-card wide">
    <h1>Wexmoor Foundation Eligibility Quiz</h1>
    <p class="sub">Answer each question to see whether your organization meets the Foundation&rsquo;s basic eligibility requirements. Eligible organizations may continue to the Letter of Inquiry.</p>
    <form class="demo-form" data-eligibility-quiz>
      {qs.map((x, i) => (
        <fieldset data-name={x.name} data-pass={x.pass}>
          <legend>{i + 1}. {x.q}</legend>
          <div class="opts">
            <label><input type="radio" name={x.name} value="yes" required /> Yes</label>
            <label><input type="radio" name={x.name} value="no" /> No</label>
          </div>
        </fieldset>
      ))}
      <p style="font-size:13px">Resources: <a href="/what-we-fund/mission-guidelines/" target="_blank">Mission &amp; Guidelines</a> &middot; <a href={documents.outcomes.path} target="_blank">Outcomes Sought (PDF)</a></p>
      <button type="submit" class="btn-primary">Check eligibility</button>
    </form>
    <div id="quiz-pass" class="form-status" hidden>
      <p><strong>Your organization appears to meet the basic eligibility requirements.</strong> You may continue to the Letter of Inquiry.</p>
      <p style="margin:0"><a class="btn-primary" href="/portal/letter-of-inquiry/">Continue to Letter of Inquiry</a></p>
    </div>
    <div id="quiz-fail" class="form-status" hidden>
      <p style="margin:0"><strong>Based on your answers, your organization does not appear to meet the Foundation&rsquo;s basic eligibility requirements.</strong> Please review our <a href="/what-we-fund/mission-guidelines/">Mission &amp; Guidelines</a> and <a href="/become-our-partner/faqs/">FAQs</a>.</p>
    </div>
  </div>
</PortalShell>
