---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/data.js';

const { title, description, section = '', bodyClass = '', noChrome = false } = Astro.props;
const fullTitle = `${title} - ${site.shortName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{fullTitle}</title>
  {description && <meta name="description" content={description} />}
  {!Astro.url.pathname.startsWith("/404") && <link rel="canonical" href={canonical} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@1,400;1,500&family=Mulish:wght@300;400;600;700;800&display=swap" rel="stylesheet" />
  <script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body class={bodyClass}>
  <div class="site" id="page">
    <a class="skip-link" href="#main">Skip to content</a>
    {!noChrome && <Header section={section} />}
    <div class="content">
      <main class="site-main" id="main">
        <slot />
      </main>
    </div>
    {!noChrome && <Footer />}
  </div>
  <slot name="after" />
  <script src="/js/site.js" defer></script>
</body>
</html>
